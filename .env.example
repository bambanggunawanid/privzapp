# PrivZapp configuration template.
# Copy to `.env` (gitignored) and fill in real values — NEVER commit .env.
# The pre-commit guard (scripts/check-secrets.py) blocks hardcoded secrets;
# anything sensitive belongs here instead.
#
# Note: the shipped app is fully client-side and needs no secrets at all.
# These are build/deploy-time settings only.

# Canonical origin baked into prerendered pages (sitemap, OG tags, JSON-LD).
BASE_URL=https://privzapp.com

# Analytics sidecar (docker-compose): GoatCounter dashboard login,
# used once on first boot to create the site.
GC_VHOST=stats.privzapp.com
GC_EMAIL=
GC_PASSWORD=
